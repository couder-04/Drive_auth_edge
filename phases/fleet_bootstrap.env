# Fleet bootstrap + timing-pad defaults (review before production ship).
# Generate updated values from store data:
#   python scripts/tune_bootstrap_params.py --store ./driveauth_store --write phases/fleet_bootstrap.env
#
DRIVEAUTH_BOOTSTRAP_MIN_TXNS=10
DRIVEAUTH_BOOTSTRAP_MIN_DAYS=3.0
DRIVEAUTH_ESCALATION_CONSTANT_TIME_MS=0

# Fleet telemetry pilot — explicit opt-in required.
# DRIVEAUTH_FLEET_TELEMETRY_OPT_IN=1
# DRIVEAUTH_FLEET_TELEMETRY_URL=https://your-collector.example/api/fleet/telemetry
# DRIVEAUTH_FLEET_TELEMETRY_INTERVAL_S=60

# Optional secure-element key wrapping (requires TPM 2.0 + tpm2-pytss on device).
# DRIVEAUTH_KEY_PROTECTOR=tpm
